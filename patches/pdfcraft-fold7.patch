diff --git a/crates/ui-egui/src/compact.rs b/crates/ui-egui/src/compact.rs
new file mode 100644
index 0000000..2d6084b
--- /dev/null
+++ b/crates/ui-egui/src/compact.rs
@@ -0,0 +1,194 @@
+//! Narrow-window presentation. The saved desktop docking tree is never rewritten.
+use crate::{Mode, PdfCraftApp, RightPanel, canvas, icons, panels, theme};
+use egui::{Align, Layout, vec2};
+
+pub(crate) fn enabled(ctx: &egui::Context) -> bool {
+    let rect = ctx.content_rect();
+    // Desktop mode includes five tabs, a 260-point search field and actions.
+    // Switch before these collide, including intermediate split-screen widths.
+    rect.width() < 780.0 || rect.height() < 480.0
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Drawer {
+    Tools,
+    Inspector,
+}
+
+fn drawer(ctx: &egui::Context, value: Option<Drawer>) {
+    ctx.data_mut(|d| d.insert_temp(egui::Id::new("compact-drawer"), value));
+}
+
+pub(crate) fn drawer_is_open(ctx: &egui::Context) -> bool {
+    enabled(ctx) && ctx.data(|d| d.get_temp::<Option<Drawer>>(egui::Id::new("compact-drawer"))).flatten().is_some()
+}
+
+pub(crate) fn top(app: &mut PdfCraftApp, ui: &mut egui::Ui) {
+    let t = theme::Tokens::get(ui.ctx());
+    egui::Panel::top("compact-tabs").exact_size(48.0).frame(egui::Frame::NONE.fill(t.titlebar).inner_margin(4)).show(ui, |ui| {
+        ui.horizontal_centered(|ui| {
+            if icons::button(ui, "house", 40.0, false, "Home").clicked() {
+                app.active = None;
+            }
+            let name = app.active_ids().and_then(|(_, id)| app.session.get(id)).map(|d| d.display_name()).unwrap_or_else(|| "Documents".into());
+            let title: String = name.chars().take(18).collect();
+            ui.menu_button(title, |ui| {
+                for index in 0..app.views.len() {
+                    if let Some(doc) = app.session.get(app.views[index].id) {
+                        if ui.selectable_label(app.active == Some(index), doc.display_name()).clicked() {
+                            app.active = Some(index);
+                            ui.close();
+                        }
+                    }
+                }
+                if app.active.is_some() && ui.button("Close document").clicked() {
+                    if let Some(index) = app.active {
+                        app.request_close_tab(index);
+                    }
+                    ui.close();
+                }
+            });
+            ui.with_layout(Layout::right_to_left(Align::Center), |ui| {
+                if icons::button(ui, "folder-open", 40.0, false, "Open PDF").clicked() {
+                    app.open_dialog();
+                }
+            });
+        });
+    });
+}
+
+pub(crate) fn mode(app: &mut PdfCraftApp, ui: &mut egui::Ui) {
+    let t = theme::Tokens::get(ui.ctx());
+    egui::Panel::top("compact-mode").exact_size(52.0).frame(egui::Frame::NONE.fill(t.chrome).inner_margin(4)).show(ui, |ui| {
+        ui.horizontal_centered(|ui| {
+            ui.spacing_mut().item_spacing.x = 2.0;
+            crate::chrome::main_menu(app, ui);
+            if icons::button(ui, "panel-left", 44.0, false, "Tools and text formatting").clicked() {
+                app.left_open = true;
+                drawer(ui.ctx(), Some(Drawer::Tools));
+            }
+            let label = match app.mode {
+                Mode::AllTools => "Tools",
+                Mode::Read => "Read",
+                Mode::Edit => "Edit",
+                Mode::Convert => "Convert",
+                Mode::Sign => "E-Sign",
+            };
+            ui.menu_button(label, |ui| {
+                for (mode, label) in
+                    [(Mode::AllTools, "All tools"), (Mode::Read, "Read"), (Mode::Edit, "Edit"), (Mode::Convert, "Convert"), (Mode::Sign, "E-Sign")]
+                {
+                    if ui.selectable_label(app.mode == mode, label).clicked() {
+                        app.select_mode(mode);
+                        drawer(ui.ctx(), (mode != Mode::Read).then_some(Drawer::Tools));
+                        ui.close();
+                    }
+                }
+            });
+            if icons::button(ui, "search", 44.0, false, "Find tools and commands").clicked() {
+                app.palette_open = true;
+            }
+            ui.add_enabled_ui(app.active.is_some(), |ui| {
+                if icons::button(ui, "save", 44.0, false, "Save PDF").clicked() {
+                    app.run_command("file.save");
+                }
+            });
+        });
+    });
+}
+
+pub(crate) fn rail(app: &mut PdfCraftApp, ui: &mut egui::Ui) {
+    let Some((index, _)) = app.active_ids() else { return };
+    let t = theme::Tokens::get(ui.ctx());
+    egui::Panel::right("compact-rail").exact_size(48.0).resizable(false).frame(egui::Frame::NONE.fill(t.chrome).inner_margin(2)).show(ui, |ui| {
+        egui::ScrollArea::vertical().id_salt("compact-rail-scroll").auto_shrink([false, false]).show(ui, |ui| {
+            for (panel, icon, label) in [
+                (RightPanel::Comments, "message-square-text", "Comments"),
+                (RightPanel::Bookmarks, "bookmark", "Bookmarks"),
+                (RightPanel::Pages, "files", "Page thumbnails"),
+                (RightPanel::Fields, "text-cursor-input", "Form fields"),
+                (RightPanel::Layers, "layers", "Layers"),
+                (RightPanel::Attachments, "paperclip", "Attachments"),
+                (RightPanel::Signatures, "signature", "Signatures"),
+                (RightPanel::Accessibility, "accessibility", "Accessibility"),
+            ] {
+                if icons::button(ui, icon, 42.0, false, label).clicked() {
+                    app.choose_right_panel(Some(panel));
+                    drawer(ui.ctx(), Some(Drawer::Inspector));
+                }
+            }
+            ui.separator();
+            if let Some(view) = app.views.get_mut(index) {
+                if icons::button(ui, "chevron-up", 42.0, false, "Previous page").clicked() {
+                    view.step_page(false);
+                }
+                ui.label((view.current + 1).to_string());
+                if icons::button(ui, "chevron-down", 42.0, false, "Next page").clicked() {
+                    view.step_page(true);
+                }
+                if icons::button(ui, "maximize", 42.0, false, "Fit page or width").clicked() {
+                    view.fit = if view.fit == canvas::Fit::Width { canvas::Fit::Page } else { canvas::Fit::Width };
+                    view.goto = Some((view.current, 0.0));
+                }
+                if icons::button(ui, "zoom-in", 42.0, false, "Zoom in").clicked() {
+                    view.zoom_step(true);
+                }
+                if icons::button(ui, "zoom-out", 42.0, false, "Zoom out").clicked() {
+                    view.zoom_step(false);
+                }
+                if icons::button(ui, "rotate-cw", 42.0, false, "Rotate view").clicked() {
+                    view.rotate_view(true);
+                }
+            }
+        });
+    });
+}
+
+pub(crate) fn show_drawer(app: &mut PdfCraftApp, ctx: &egui::Context) {
+    if !enabled(ctx) {
+        return;
+    }
+    for reveal in std::mem::take(&mut app.pending_panel_reveals) {
+        match reveal {
+            crate::docking::Panel::Tools => drawer(ctx, Some(Drawer::Tools)),
+            crate::docking::Panel::Inspector => drawer(ctx, Some(Drawer::Inspector)),
+            _ => {}
+        }
+    }
+    let selected = ctx.data(|d| d.get_temp::<Option<Drawer>>(egui::Id::new("compact-drawer"))).flatten();
+    let Some(selected) = selected else { return };
+    let title = if selected == Drawer::Tools { "Tools and formatting" } else { "Document panel" };
+    let bounds = ctx.content_rect().shrink(8.0);
+    let old_tool = app.quick_tool;
+    let mut open = true;
+    let mut close_panel = false;
+    egui::Window::new(title)
+        .id(egui::Id::new("compact-panel-window"))
+        .open(&mut open)
+        .resizable(false)
+        .collapsible(false)
+        .constrain_to(bounds)
+        .fixed_pos(bounds.min)
+        .fixed_size(vec2((bounds.width() - 16.0).max(80.0), (bounds.height() - 44.0).max(40.0)))
+        .scroll([true, true])
+        .show(ctx, |ui| {
+            ui.set_max_width((bounds.width() - 32.0).max(64.0));
+            ui.spacing_mut().interact_size.y = 40.0;
+            close_panel = ui.button("Back to document").clicked();
+            ui.separator();
+            if selected == Drawer::Tools {
+                panels::left_panel(app, ui);
+            } else {
+                panels::right_panel(app, ui);
+            }
+        });
+    if !open
+        || close_panel
+        || old_tool != app.quick_tool
+        || app.dialog.is_some()
+        || (selected == Drawer::Tools && !app.left_open)
+        || (selected == Drawer::Inspector && app.right.is_none())
+    {
+        drawer(ctx, None);
