+#[test]
+fn mobile_text_wins_over_full_page_background_image() {
+    let stream = "q 200 0 0 300 0 0 cm /Bg Do Q BT /F1 24 Tf 20 150 Td (Page 1) Tj ET";
+    let objects = [
+        "<< /Type /Catalog /Pages 2 0 R >>".to_string(),
+        "<< /Type /Pages /Kids [4 0 R] /Count 1 /MediaBox [0 0 200 300] >>".into(),
+        "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>".into(),
+        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R /Resources << /Font << /F1 3 0 R >> /XObject << /Bg 6 0 R >> >> >>".into(),
+        format!("<< /Length {} >>\nstream\n{stream}\nendstream", stream.len()),
+        "<< /Type /XObject /Subtype /Image /Width 1 /Height 1 /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /ASCIIHexDecode /Length 7 >>\nstream\ne6f0ff>\nendstream".into(),
+    ];
+    let mut bytes = b"%PDF-1.7\n".to_vec();
+    let mut offsets = Vec::new();
+    for (i, object) in objects.iter().enumerate() {
+        offsets.push(bytes.len());
+        bytes.extend_from_slice(format!("{} 0 obj\n{object}\nendobj\n", i + 1).as_bytes());
+    }
+    let xref = bytes.len();
+    bytes.extend_from_slice(b"xref\n0 7\n0000000000 65535 f \n");
+    for offset in offsets {
+        bytes.extend_from_slice(format!("{offset:010} 00000 n \n").as_bytes());
+    }
+    bytes.extend_from_slice(format!("trailer\n<< /Size 7 /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF\n").as_bytes());
+    let mut h = Harness::builder().with_size(egui::vec2(1000.0, 900.0)).build_eframe(move |_| {
+        let mut app = PdfCraftApp::new();
+        app.open_bytes("background.pdf", None, bytes.clone()).unwrap();
+        app.quick_tool = pdfcraft_ui_egui::QuickTool::EditText;
+        app
+    });
+    h.run_steps(5);
+    let id = h.state().views[0].id;
+    assert_eq!(h.state().session.get(id).unwrap().page_images(0).len(), 1, "fixture must contain a detected full-page image");
+    let rect = h.state().views[0].page_screen_rect(0).unwrap();
+    let at = egui::pos2(rect.left() + rect.width() * 0.3, rect.top() + rect.height() * 142.0 / 300.0);
+    h.hover_at(at);
+    h.run_steps(1);
+    h.drag_at(at);
+    h.run_steps(1);
+    h.drop_at(at);
+    h.run_steps(2);
+    assert!(h.state().views[0].line_editor.is_some());
+    assert!(h.state().views[0].image_selection.is_none());
+}
