+#[test]
+fn mobile_cancel_does_not_commit_a_draft() {
+    let mut h = Harness::builder().with_size(egui::vec2(380.0, 840.0)).build_eframe(|_| {
+        let mut app = PdfCraftApp::new();
+        app.set_option("language", "en").unwrap();
+        app.open_bytes("phone.pdf", None, fixture(1)).unwrap();
+        app.quick_tool = pdfcraft_ui_egui::QuickTool::EditText;
+        app
+    });
+    h.run_steps(5);
+    let r = h.state().views[0].page_screen_rect(0).unwrap();
+    let at = egui::pos2(r.left() + r.width() * 0.2, r.top() + r.height() * 142.0 / 300.0);
+    h.hover_at(at);
+    h.run_steps(1);
+    h.drag_at(at);
+    h.run_steps(1);
+    h.drop_at(at);
+    h.run_steps(3);
+    h.state_mut().views[0].line_editor.as_mut().expect("paragraph opens").text = "Discard this draft".into();
+    h.run_steps(2);
+    h.get_by_label("Tools and text formatting").click();
+    h.run_steps(3);
+    assert_eq!(h.state().views[0].line_editor.as_ref().unwrap().text, "Discard this draft");
+    h.get_by_label("Back to document").click();
+    h.run_steps(3);
+    assert_eq!(h.state().views[0].line_editor.as_ref().unwrap().text, "Discard this draft");
+    h.get_by_label("Cancel").click();
+    h.run_steps(4);
+    assert!(h.state().views[0].line_editor.is_none());
+    let doc = h.state().session.get(h.state().views[0].id).unwrap();
+    assert_eq!(doc.text_lines(0)[0].text, "Page 1");
+    assert_eq!(doc.can_undo(), None, "Cancel must not apply on pointer-down focus loss");
+}
