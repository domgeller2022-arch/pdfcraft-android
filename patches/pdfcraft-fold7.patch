+#[test]
+fn mobile_cover_layout_preserves_desktop_docking() {
+    let mut h = Harness::builder().with_size(egui::vec2(900.0, 980.0)).build_eframe(|_| {
+        let mut app = PdfCraftApp::new();
+        app.set_option("language", "en").unwrap();
+        app.open_bytes("phone.pdf", None, fixture(1)).unwrap();
+        app
+    });
+    // Let desktop visibility reconcile first (the default empty inspector hides).
+    h.run_steps(5);
+    let layout = serde_json::to_value(&h.state().docking).unwrap();
+    h.set_size(egui::vec2(380.0, 840.0));
+    h.run_steps(5);
+    assert_eq!(layout, serde_json::to_value(&h.state().docking).unwrap());
+    let viewport = h.state().views[0].viewport_rect();
+    assert!(viewport.width() > 280.0, "side docks must not squeeze the phone canvas: {viewport:?}");
+    h.get_by_label("Save PDF");
+    h.get_by_label("Open PDF");
+    h.get_by_label("Tools and text formatting");
+    for label in ["Save PDF", "Open PDF", "Tools and text formatting"] {
+        let rect = h.get_by_label(label).rect();
+        assert!(rect.left() >= 0.0 && rect.right() <= 380.0, "{label} must fit the cover screen: {rect:?}");
+    }
+    if let Ok(dir) = std::env::var("PDFCRAFT_PHONE_SCREENSHOTS") {
+        std::fs::create_dir_all(&dir).unwrap();
+        h.render().unwrap().save(format!("{dir}/cover.png")).unwrap();
+    }
+    h.state_mut().execute("edit.header_footer");
+    h.run_steps(5);
+    for label in ["Cancel", "OK"] {
+        let rect = h.get_by_label(label).rect();
+        assert!(rect.left() >= 0.0 && rect.right() <= 380.0 && rect.bottom() <= 840.0, "{label}: {rect:?}");
+    }
+    if let Ok(dir) = std::env::var("PDFCRAFT_PHONE_SCREENSHOTS") {
+        h.render().unwrap().save(format!("{dir}/cover-dialog.png")).unwrap();
+    }
+    h.set_size(egui::vec2(380.0, 420.0));
+    h.run_steps(5);
+    for label in ["Cancel", "OK"] {
+        let rect = h.get_by_label(label).rect();
+        assert!(rect.left() >= 0.0 && rect.right() <= 380.0 && rect.bottom() <= 420.0, "keyboard {label}: {rect:?}");
+    }
+    h.get_by_label("Cancel").click();
+    h.run_steps(3);
+    assert!(h.state().dialog.is_none());
+    for size in [egui::vec2(700.0, 840.0), egui::vec2(840.0, 380.0)] {
+        h.set_size(size);
+        h.run_steps(5);
+        for label in ["Save PDF", "Open PDF", "Tools and text formatting"] {
+            let rect = h.get_by_label(label).rect();
+            assert!(rect.left() >= 0.0 && rect.right() <= size.x && rect.bottom() <= size.y, "intermediate/landscape {label}: {rect:?}");
+        }
+    }
+    h.set_size(egui::vec2(900.0, 980.0));
+    h.run_steps(5);
+    assert_eq!(layout, serde_json::to_value(&h.state().docking).unwrap(), "unfold restores the saved desktop layout");
+    if let Ok(dir) = std::env::var("PDFCRAFT_PHONE_SCREENSHOTS") {
+        h.render().unwrap().save(format!("{dir}/inner.png")).unwrap();
+    }
+}
