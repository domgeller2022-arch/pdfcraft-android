+/// A touch release removes hover in the same frame on eframe/WebView.
+#[test]
+fn mobile_touch_release_opens_existing_paragraph() {
+    let mut h = harness(1, |app| {
+        app.quick_tool = pdfcraft_ui_egui::QuickTool::EditText;
+    });
+    let r = h.state().views[0].page_screen_rect(0).unwrap();
+    let at = egui::pos2(r.left() + 40.0 / 200.0 * r.width(), r.top() + 142.0 / 300.0 * r.height());
+    h.input_mut().events.extend([
+        egui::Event::PointerMoved(at),
+        egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: true, modifiers: Modifiers::NONE },
+    ]);
+    h.run_steps(1);
+    h.input_mut().events.extend([
+        egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: false, modifiers: Modifiers::NONE },
+        egui::Event::PointerGone,
+    ]);
+    h.run_steps(1);
+    assert!(h.state().views[0].line_editor.is_some(), "touch release must open existing text without hover");
+}
